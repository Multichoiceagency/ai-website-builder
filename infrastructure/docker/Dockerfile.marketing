# syntax=docker/dockerfile:1.7
# Marketing site — Webtify clone (static Next.js export).
# Build from repo root:
#   docker build -f infrastructure/docker/Dockerfile.marketing -t platform-marketing .
FROM node:22-bookworm-slim AS deps
RUN corepack enable && corepack prepare pnpm@11.17.0 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/marketing/package.json apps/marketing/
RUN pnpm install --frozen-lockfile --filter @platform/marketing...

FROM deps AS build
COPY apps/marketing apps/marketing
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @platform/marketing build

FROM nginx:1.27-alpine AS runner
COPY --from=build /app/apps/marketing/out /usr/share/nginx/html
COPY infrastructure/docker/marketing.nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=5 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
