# syntax=docker/dockerfile:1.7
# Build from repo root:
#   docker build -f infrastructure/docker/Dockerfile.core-api -t platform-core-api .
FROM node:22-bookworm-slim AS deps
RUN corepack enable && corepack prepare pnpm@11.17.0 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages/schemas/package.json packages/schemas/
COPY packages/blocks/package.json packages/blocks/
COPY packages/permissions/package.json packages/permissions/
COPY packages/templates/package.json packages/templates/
COPY services/core-api/package.json services/core-api/
# Coolify injects NODE_ENV=production into every stage (build-arg). That skips
# TypeScript (devDependencies) and breaks `tsc`.
RUN NODE_ENV=development pnpm install --frozen-lockfile --prod=false --filter @platform/core-api...

FROM deps AS build
COPY packages/schemas packages/schemas
COPY packages/blocks packages/blocks
COPY packages/permissions packages/permissions
COPY packages/templates packages/templates
COPY services/core-api services/core-api
# Workspace package tsconfigs extend the monorepo base.
COPY tsconfig.base.json ./
RUN NODE_ENV=development pnpm install --frozen-lockfile --prod=false --filter @platform/core-api...
RUN pnpm --filter @platform/schemas build \
 && pnpm --filter @platform/blocks build \
 && pnpm --filter @platform/permissions build \
 && pnpm --filter @platform/templates build \
 && pnpm --filter @platform/core-api build

FROM node:22-bookworm-slim AS runner
# Skip apt ffmpeg here — it bloated Coolify builds and got the job killed (exit 255).
# Video frame extraction degrades gracefully when ffmpeg is absent.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && corepack enable && corepack prepare pnpm@11.17.0 --activate
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app /app
WORKDIR /app/services/core-api
EXPOSE 4000
HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=10 \
  CMD node -e "fetch('http://127.0.0.1:4000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/server.js"]
