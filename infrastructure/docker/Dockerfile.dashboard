# syntax=docker/dockerfile:1.7
# Build from repo root:
#   docker build -f infrastructure/docker/Dockerfile.dashboard -t platform-dashboard .
FROM node:22-bookworm-slim AS deps
RUN corepack enable && corepack prepare pnpm@11.17.0 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/dashboard/package.json apps/dashboard/
RUN pnpm install --frozen-lockfile --filter @platform/dashboard...

FROM deps AS build
COPY apps/dashboard apps/dashboard
COPY tsconfig.base.json ./
# Re-link workspace deps — source COPY must not leave a broken apps/*/node_modules.
RUN pnpm install --frozen-lockfile --filter @platform/dashboard...
ENV NODE_ENV=production
ENV NUXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @platform/schemas build \
 && pnpm --filter @platform/theming build \
 && pnpm --filter @platform/blocks build \
 && pnpm --filter @platform/templates build \
 && pnpm --filter @platform/dashboard build

FROM node:22-bookworm-slim AS runner
# curl + wget: Coolify HTTP probes use whichever is available
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl wget \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app/apps/dashboard
ENV NODE_ENV=production
ENV NUXT_TELEMETRY_DISABLED=1
ENV HOST=0.0.0.0
ENV PORT=3000
# Nuxt's .output is self-contained — shipping the monorepo node_modules tripled
# the image (1.5GB → ~350MB) and overflowed the 38GB Coolify host.
COPY --from=build /app/apps/dashboard/.output ./.output
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=5s --start-period=40s --retries=6 \
  CMD curl -fsS "http://127.0.0.1:3000/" >/dev/null || exit 1
CMD ["node", ".output/server/index.mjs"]
