# syntax=docker/dockerfile:1.7
# Build from repo root:
#   docker build -f infrastructure/docker/Dockerfile.storefront -t platform-storefront .
FROM node:22-bookworm-slim AS deps
RUN corepack enable && corepack prepare pnpm@11.17.0 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/storefront/package.json apps/storefront/
# Motionsites islands are gitignored under public/ — build them in-image.
# Coolify injects NODE_ENV=production into every stage (build-arg). That skips
# TypeScript/Vite (devDependencies) and breaks `tsc` / island / Nuxt builds.
RUN NODE_ENV=development pnpm install --frozen-lockfile --prod=false \
  --filter @platform/storefront... \
  --filter @platform/motionsites-islands...

FROM deps AS build
COPY apps/storefront apps/storefront
COPY tsconfig.base.json ./
RUN NODE_ENV=development pnpm install --frozen-lockfile --prod=false \
  --filter @platform/storefront... \
  --filter @platform/motionsites-islands...
ENV NODE_ENV=production
ENV NUXT_TELEMETRY_DISABLED=1
# Build React islands into apps/*/public/motionsites/islands before Nuxt so
# published pages can load MotionSites iframes (otherwise → 404 in Coolify).
RUN pnpm --filter @platform/motionsites-islands build \
 && pnpm --filter @platform/schemas build \
 && pnpm --filter @platform/blocks build \
 && pnpm --filter @platform/tracking build \
 && pnpm --filter @platform/storefront build

FROM node:22-bookworm-slim AS runner
# curl + wget: Coolify HTTP probes use whichever is available
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl wget \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app/apps/storefront
ENV NODE_ENV=production
ENV NUXT_TELEMETRY_DISABLED=1
ENV HOST=0.0.0.0
ENV PORT=3001
# Nuxt's .output is self-contained — shipping the monorepo node_modules tripled
# the image (1.5GB → ~350MB) and overflowed the 38GB Coolify host.
COPY --from=build /app/apps/storefront/.output ./.output
EXPOSE 3001
HEALTHCHECK --interval=10s --timeout=5s --start-period=40s --retries=6 \
  CMD curl -fsS "http://127.0.0.1:3001/health" >/dev/null || exit 1
CMD ["node", ".output/server/index.mjs"]
