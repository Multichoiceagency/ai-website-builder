# syntax=docker/dockerfile:1.7
# Build from repo root:
#   docker build -f infrastructure/docker/Dockerfile.storefront -t platform-storefront .
FROM node:22-bookworm-slim AS deps
RUN corepack enable && corepack prepare pnpm@11.17.0 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/storefront/package.json apps/storefront/
RUN pnpm install --frozen-lockfile --filter @platform/storefront...

FROM deps AS build
COPY apps/storefront apps/storefront
COPY tsconfig.base.json ./
ENV NODE_ENV=production
ENV NUXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @platform/schemas build \
 && pnpm --filter @platform/blocks build \
 && pnpm --filter @platform/templates build \
 && pnpm --filter @platform/storefront build

FROM node:22-bookworm-slim AS runner
RUN corepack enable && corepack prepare pnpm@11.17.0 --activate
WORKDIR /app
ENV NODE_ENV=production
ENV NUXT_TELEMETRY_DISABLED=1
ENV HOST=0.0.0.0
ENV PORT=3001
COPY --from=build /app /app
WORKDIR /app/apps/storefront
EXPOSE 3001
CMD ["node", ".output/server/index.mjs"]
