# syntax=docker/dockerfile:1.7
# Build from repo root:
#   docker build -f infrastructure/docker/Dockerfile.admin -t platform-admin .
FROM node:22-bookworm-slim AS deps
RUN corepack enable && corepack prepare pnpm@11.17.0 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/admin/package.json apps/admin/
# Coolify injects NODE_ENV=production into every stage (build-arg). That skips
# TypeScript (devDependencies) and breaks `tsc` / Nuxt builds.
RUN NODE_ENV=development pnpm install --frozen-lockfile --prod=false --filter @platform/admin...

FROM deps AS build
COPY apps/admin apps/admin
COPY tsconfig.base.json ./
RUN NODE_ENV=development pnpm install --frozen-lockfile --prod=false --filter @platform/admin...
ENV NODE_ENV=production
ENV NUXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @platform/schemas build \
 && pnpm --filter @platform/admin build

FROM node:22-bookworm-slim AS runner
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl wget \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app/apps/admin
ENV NODE_ENV=production
ENV NUXT_TELEMETRY_DISABLED=1
ENV HOST=0.0.0.0
ENV PORT=3002
COPY --from=build /app/apps/admin/.output ./.output
EXPOSE 3002
HEALTHCHECK --interval=10s --timeout=5s --start-period=40s --retries=6 \
  CMD curl -fsS "http://127.0.0.1:3002/" >/dev/null || exit 1
CMD ["node", ".output/server/index.mjs"]
