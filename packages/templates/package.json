{
  "name": "@platform/templates",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "import:motionsites": "node scripts/import-motionsites.mjs",
    "import:backgrounds": "node scripts/import-backgrounds.mjs"
  },
  "dependencies": {
    "@platform/blocks": "workspace:*",
    "@platform/schemas": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
