# ---------------------------------------------------------------------------
# Local development environment.
# Copy to `.env` and adjust. NEVER commit `.env`.
#   cp .env.example .env
# Generate secrets with: openssl rand -base64 32
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- PostgreSQL ------------------------------------------------------------
# Owner role: used by migrations only. Bypasses RLS (table owner).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-postgres

# Application role: used by every service at runtime. RLS is ENFORCED for it.
APP_DB_USER=app_user
APP_DB_PASSWORD=change-me-local-app-user

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6380

# --- Object storage (MinIO, S3-compatible) ---------------------------------
S3_ENDPOINT=http://localhost:9100
S3_REGION=eu-central-1
S3_BUCKET=platform-media
S3_ACCESS_KEY=change-me-local-minio-user
S3_SECRET_KEY=change-me-local-minio-password
S3_PUBLIC_URL=http://localhost:9100/platform-media

# --- Core API --------------------------------------------------------------
CORE_API_PORT=4000
CORE_API_URL=http://localhost:4000
SESSION_SECRET=generate-with-openssl-rand-base64-32
SESSION_TTL_SECONDS=604800

# --- Frontends -------------------------------------------------------------
DASHBOARD_PORT=3000
DASHBOARD_URL=http://localhost:3000
STOREFRONT_PORT=3001
STOREFRONT_URL=http://localhost:3001

# CORS allow-list for the API (comma separated).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# --- AI Gateway (Phase 2 — not required for Phase 1) -----------------------
# Every one of these is optional. With none of them set the deterministic
# composer writes the copy, which is the configuration the platform ships in.
# ANTHROPIC_API_KEY=sk-ant-EXAMPLE-PLACEHOLDER-NOT-REAL
# OPENAI_API_KEY=sk-EXAMPLE-PLACEHOLDER-NOT-REAL
#
# Google Gemini. This is a Gemini API key from Google AI Studio and is NOT the
# same credential as GOOGLE_API_KEY, which is scoped to Places and the Business
# Profile APIs. Keep them separate.
# GEMINI_API_KEY=AIza-EXAMPLE-PLACEHOLDER-NOT-REAL
# Optional model override. Leave unset to use the provider's default.
# GEMINI_MODEL=gemini-3.6-flash

# --- Google integration -----------------------------------------------------
# OAuth 2.0 Client ID of type "Web application" from Google Cloud Console.
# An API key will NOT work: only OAuth can authorize access to a user's own
# business data. Never commit real values.
#
# Enable these APIs on the project first:
#   mybusinessbusinessinformation · mybusinessaccountmanagement
#   searchconsole · analyticsdata
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-the-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google/callback
# Google Ads additionally requires a developer token (phase 6).
# GOOGLE_ADS_DEVELOPER_TOKEN=
