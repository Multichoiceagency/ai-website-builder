# ---------------------------------------------------------------------------
# Local development environment.
# Copy to `.env` and adjust. NEVER commit `.env`.
#   cp .env.example .env
# Generate secrets with: openssl rand -base64 32
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- PostgreSQL ------------------------------------------------------------
# Owner role: used by migrations only. Bypasses RLS (table owner).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-postgres

# Application role: used by every service at runtime. RLS is ENFORCED for it.
APP_DB_USER=app_user
APP_DB_PASSWORD=change-me-local-app-user

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6380

# --- Object storage (MinIO, S3-compatible) ---------------------------------
S3_ENDPOINT=http://localhost:9100
S3_REGION=eu-central-1
S3_BUCKET=platform-media
S3_ACCESS_KEY=change-me-local-minio-user
S3_SECRET_KEY=change-me-local-minio-password
S3_PUBLIC_URL=http://localhost:9100/platform-media
# Still image upload ceiling (bytes). Default 25 MiB. Videos use MEDIA_VIDEO_MAX_BYTES (64 MiB).
# MEDIA_MAX_BYTES=26214400
# MEDIA_VIDEO_MAX_BYTES=67108864
# Pexels free photos for Media → Stock (https://www.pexels.com/api/)
# PEXELS_API_KEY=
# Optional later: Figma REST import for Design mode (not required for HTML / clipboard paste).
# FIGMA_ACCESS_TOKEN=
# Video → scroll frames needs ffmpeg on the core-api host (`brew install ffmpeg`).
# Caps: ~24 fps, max 120 frames, first 5s, max width 1080 (PNG).

# --- Core API --------------------------------------------------------------
CORE_API_PORT=4000
CORE_API_URL=http://localhost:4000
SESSION_SECRET=generate-with-openssl-rand-base64-32
SESSION_TTL_SECONDS=604800

# --- Frontends -------------------------------------------------------------
DASHBOARD_PORT=3000
DASHBOARD_URL=http://localhost:3000
STOREFRONT_PORT=3001
STOREFRONT_URL=http://localhost:3001

# CORS allow-list for the API (comma separated).
# In non-production, http://{slug}.localhost:* is also allowed for tenant previews.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# --- AI Gateway (Phase 2 — not required for Phase 1) -----------------------
# Google Gemini — preferred default for discovery → copy (scraped websites),
# section AI, and Motionsites codegen. Key from Google AI Studio; NOT the same
# as GOOGLE_API_KEY (Places / Business Profile). Accepted prefixes: AIza… or AQ.…
# — https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza-EXAMPLE-PLACEHOLDER-NOT-REAL
# Optional model override. Default is gemini-2.5-flash (stable; thinking off).
# Do not use gemini-2.5-pro for product paths — it is thinking-only and often
# returns empty output after ~13s.
# GEMINI_MODEL=gemini-2.5-flash
# Optional Motionsites codegen override (defaults to GEMINI_MODEL / 2.5-flash).
# GEMINI_CODEGEN_MODEL=gemini-2.5-flash
#
# Anthropic is the fallback language model when Gemini is unset or errors.
# ANTHROPIC_API_KEY=sk-ant-EXAMPLE-PLACEHOLDER-NOT-REAL
# OPENAI_API_KEY=sk-EXAMPLE-PLACEHOLDER-NOT-REAL
#
# Every one of these is optional. With none of them set the deterministic
# composer writes the copy, which is the configuration the platform ships in.

# Maps / Places / PageSpeed API key (platform-owned — not OAuth).
# Enable: Places API (New), Geocoding API, PageSpeed Insights API.
# GOOGLE_API_KEY=

# --- Google integration -----------------------------------------------------
# OAuth 2.0 Client ID of type "Web application" from Google Cloud Console.
# An API key will NOT work: only OAuth can authorize access to a user's own
# business data. Never commit real values.
#
# Enable these APIs on the project first:
#   mybusinessbusinessinformation · mybusinessaccountmanagement
#   searchconsole · analyticsdata · analyticsadmin
#   gmail · googleads (Ads also needs a developer token)
#   places (New) · geocoding · pagespeedonline (via GOOGLE_API_KEY)
#
# OAuth consent screen must list every scope we request (one Connect / Sign-up):
#   openid · email · profile
#   business.manage · webmasters · analytics.readonly
#   adwords · gmail.send
# Sensitive/restricted scopes may need Google verification for production.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-the-client-secret
# Integrations callback (Business Profile / Search Console / Analytics / Ads / Gmail).
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google/callback
# Dashboard Sign-In / Sign-Up with Google — same product scopes as integrations
# so signup can store a workspace connection. Register BOTH redirect URIs on the
# Google Cloud OAuth client (Web application).
GOOGLE_AUTH_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
# Google Ads additionally requires a developer token.
# GOOGLE_ADS_DEVELOPER_TOKEN=

# --- Public origins (Coolify FQDNs — never leave as localhost in production) --
CORE_API_URL=http://localhost:4000
DASHBOARD_URL=http://localhost:3000
STOREFRONT_URL=http://localhost:3001
# PLATFORM_EDGE_HOSTNAME=edge.example.com
# STOREFRONT_PUBLIC_HOST=edge.example.com

# --- Nango (OAuth broker for workspace integrations) ------------------------
# Self-host: pnpm infra:nango  → dashboard http://localhost:3003
# Production: set NANGO_PUBLIC_* to HTTPS Coolify domains; webhook → CORE_API_URL
# When NANGO_SECRET_KEY is set, Connectors / Settings → Integrations use Nango
# Connect sessions. Catalog unique keys (create via `pnpm nango:bootstrap`):
# google, slack, stripe, shopify, hubspot, facebook, mailchimp, notion, airtable,
# linkedin, salesforce, intercom, zendesk, pipedrive, klaviyo, google-calendar,
# google-mail, whatsapp-business, tiktok-ads, twitter.
# Webhook: ${CORE_API_URL}/api/v1/integrations/nango/webhook
# Without NANGO_SECRET_KEY, only Google legacy PKCE remains available.
# NANGO_SECRET_KEY=
# NANGO_HOST=http://localhost:3003
# NANGO_WEBHOOK_SECRET=
# NANGO_GOOGLE_INTEGRATION_ID=google
# NANGO_SERVER_PORT=3003
# NANGO_CONNECT_UI_PORT=3009
# NANGO_ENCRYPTION_KEY=   # openssl rand -base64 32
# NANGO_DB_PASSWORD=nango
# NANGO_SERVER_URL=http://localhost:3003
# NANGO_PUBLIC_SERVER_URL=http://localhost:3003
# NANGO_PUBLIC_CONNECT_URL=http://localhost:3009

# --- Platform edge (custom domains) -----------------------------------------
# Customers point A/CNAME records at these. Shown in Settings → Domains.
# PLATFORM_EDGE_HOSTNAME=edge.example.com
# PLATFORM_EDGE_IPV4=203.0.113.10

# --- WhatsApp (OpenWA) ------------------------------------------------------
# https://github.com/rmyndharis/OpenWA — unofficial gateway; use a dedicated number.
# Start: docker compose -f infrastructure/docker/docker-compose.yml \
#   -f infrastructure/docker/docker-compose.openwa.yml --profile openwa up -d openwa
# Production: OPENWA_BASE_URL must be a public HTTPS URL (Coolify), not localhost.
# Dashboard Support desk can create a session and show the QR in-app.
# OPENWA_BASE_URL=http://localhost:2785
# OPENWA_API_KEY=dev-openwa-change-me
# OPENWA_WEBHOOK_SECRET=
# OPENWA_PORT=2785

# --- Assistant RAG (optional Obsidian vault sync) ---------------------------
# OBSIDIAN_VAULT_PATH=/absolute/path/to/vault

# --- Commerce payments ------------------------------------------------------
# Prefer Mollie for NL/EU (iDEAL) or Stripe globally. Manual checkout always works.
# Tenant secrets can also be set in Commerce → Payments (encrypted at rest).
# MOLLIE_API_KEY=test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=

# --- Commerce engines (optional platform-wide defaults) ---------------------
# Prefer per-tenant credentials under Commerce → Settings → Connection.
# MEDUSA_URL=http://localhost:9000
# MEDUSA_API_KEY=
# SHOPIFY_SHOP=mystore.myshopify.com
# SHOPIFY_ACCESS_TOKEN=shpat_...
# SHOPIFY_API_VERSION=2024-10
# SHOPIFY_CURRENCY=EUR
# WOOCOMMERCE_STORE_URL=https://shop.example.com
# WOOCOMMERCE_CONSUMER_KEY=ck_...
# WOOCOMMERCE_CONSUMER_SECRET=cs_...
# WOOCOMMERCE_CURRENCY=EUR
